# ─────────────────────────────────────────────
# Runtime — solo Tomcat + WAR pre-compilado
#
# El WAR es generado por Jenkins (Stage 9: compile.complete + antWar)
# contra clone_after, donde el agente Jenkins sí tiene acceso a RDS.
# Docker solo empaqueta el artefacto resultante — sin compilación,
# sin acceso a DB.
# ─────────────────────────────────────────────
FROM tomcat:9.0-jdk17

RUN apt-get update && apt-get install -y postgresql-client curl && rm -rf /var/lib/apt/lists/*

# ETP-5751 — Datadog Java agent, required by the Datadog Feature Flags provider (dd-openfeature).
# Baked in, but only LOADED by docker-entrypoint.sh when DD_FEATURE_FLAGS_ENABLED is true, so an
# environment without DD_* variables runs exactly as before.
# VERSION LOCK: must equal ext.ddJavaAgentVersion in com.etendoerp.go/build.gradle. CI passes that
# value as --build-arg (deploy-staging.yml); bumping it without updating DD_JAVA_AGENT_SHA256 below
# fails the checksum, which is the point — both pins move together.
ARG DD_JAVA_AGENT_VERSION=1.66.0
ARG DD_JAVA_AGENT_SHA256=5f0eb51160fade367d97404624561b6666f7475fb1453a7a73237eb643e398d8
RUN mkdir -p /opt/datadog \
 && curl -fsSL -o /opt/datadog/dd-java-agent.jar \
    "https://repo1.maven.org/maven2/com/datadoghq/dd-java-agent/${DD_JAVA_AGENT_VERSION}/dd-java-agent-${DD_JAVA_AGENT_VERSION}.jar" \
 && echo "${DD_JAVA_AGENT_SHA256}  /opt/datadog/dd-java-agent.jar" | sha256sum -c -
ENV DD_JAVA_AGENT_JAR=/opt/datadog/dd-java-agent.jar

# Limpiar webapps por defecto
RUN rm -rf "$CATALINA_HOME/webapps"/*

# Copiar el WAR pre-compilado en Jenkins y expandirlo
COPY lib/etendo.war /tmp/etendo.war
RUN mkdir -p "$CATALINA_HOME/webapps/etendo" \
 && cd "$CATALINA_HOME/webapps/etendo" \
 && jar xf /tmp/etendo.war \
 && rm /tmp/etendo.war

# Directorio de adjuntos requerido por Etendo
RUN mkdir -p /opt/openbravo/attachments

# Entrypoint: inyecta openbravo.properties desde env vars y arranca Tomcat
COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=5 \
    CMD curl -sf http://localhost:8080/etendo/security/Login || exit 1

ENTRYPOINT ["/docker-entrypoint.sh"]
